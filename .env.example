TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
NEWS_API_KEY=
FREENEWS_API_KEY=
# Optional backward-compatible alias if you already use this variable name
FREEN_EWS_API_KEY=
# Finnhub key (supports both spellings for compatibility)
FINNHUB_API_KEY=
FINHUB_API_KEY=
NEWS_FETCH_PRIORITY=newsapi,freenews,rss
FREENEWS_API_URL=https://freenewsapi.com/api/v1/news
FINNHUB_API_URL=https://finnhub.io/api/v1

# Personalization
RECIPIENT_NAME=Sunil
TZ=Europe/Oslo

# Bot runtime
REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_MESSAGE_MAX_CHARS=3900
STATE_FILE=.news_bot_state.json
COMMAND_POLL_ENABLED=true
# Telegram long-poll hold time in seconds (commands respond near-instantly).
COMMAND_LONG_POLL_TIMEOUT_SECONDS=25
# Deprecated: retained for compatibility, no longer used (long-polling replaced interval polling).
COMMAND_POLL_INTERVAL_MINUTES=2
HEALTH_PING_ENABLED=true
HEALTH_PING_CHAT_ID=

# News quality filters (comma-separated domains)
# Note: BBC RSS links point at bbc.co.uk, so both BBC domains are listed.
# A trusted domain missing from this list means those items are dropped silently.
TRUSTED_NEWS_DOMAINS=reuters.com,bloomberg.com,cnbc.com,finance.yahoo.com,yahoo.com,ft.com,bbc.com,bbc.co.uk,theguardian.com,nrk.no,aftenposten.no,e24.no,apnews.com,marketwatch.com
BLOCKED_NEWS_DOMAINS=news.google.com,pinterest.com,tiktok.com

# News ranking and deduplication
# Ranking runs on a local LLM (Ollama). No API key and no data leaves your
# network. If the endpoint is unreachable the bot falls back to a
# deterministic heuristic ranker and the briefing still renders.
NEWS_RANKER_ENABLED=true
# `ollama` resolves to whichever Ollama is on the ranker network (see
# RANKER_NETWORK below). Use http://localhost:11434 outside Docker.
NEWS_RANKER_URL=http://ollama:11434
# Must already be pulled into Ollama. qwen2.5:3b (~1.9GB) fits a Raspberry Pi
# 5; a 7B+ model ranks noticeably better if you have the RAM and disk.
NEWS_RANKER_MODEL=qwen2.5:3b
# Measured on a Pi 5 with a warm qwen2.5:3b: 14 candidates ~107s, 20 ~236s.
# llama3.2:3b needs ~193s at 14 and exceeds the 240s timeout at 20.
NEWS_RANKER_TIMEOUT_SECONDS=240
# The LLM re-ranks the heuristic's top N instead of the whole pool. Raise it
# on faster hardware; latency scales roughly with this number.
NEWS_RANKER_MAX_CANDIDATES=14

# Reuse an Ollama from another compose project instead of the bundled one:
#   RANKER_NETWORK=poster-bot_default
#   RANKER_NETWORK_EXTERNAL=true
# Find the network with:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' ollama
RANKER_NETWORK=
RANKER_NETWORK_EXTERNAL=false
# Drop dated items older than this. Items with no date are exempt.
NEWS_MAX_AGE_HOURS=30
NEWS_CANDIDATE_POOL_SIZE=60
# Suppress a story shown in the last N days (N includes today).
NEWS_DEDUP_WINDOW_DAYS=7
# Recent titles passed to the ranker for cross-day paraphrase suppression.
NEWS_RECENT_TITLE_DAYS=3
# Weight overrides only, e.g. markets:2.5,sports:0.1
# Categories: markets, norway, india, tech, sports, celebrity, crime,
# lifestyle, shopping
NEWS_TOPIC_WEIGHTS=

# Public feed configuration (comma-separated URLs / screener IDs)
GLOBAL_NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.cnbc.com/id/100727362/device/rss/rss.html,https://feeds.apnews.com/apf-topnews
BUSINESS_NEWS_FEEDS=https://www.cnbc.com/id/10001147/device/rss/rss.html,https://finance.yahoo.com/news/rssindex,https://feeds.marketwatch.com/marketwatch/topstories/
NORWAY_NEWS_FEEDS=https://www.nrk.no/toppsaker.rss,https://e24.no/rss,https://www.aftenposten.no/rss
FUND_SCREENERS=conservative_foreign_funds,solid_large_growth_funds,high_yield_bond
SCREENER_QUOTE_LIMIT=50
SCREENER_REQUEST_TIMEOUT_SECONDS=6
SCREENER_CACHE_TTL_SECONDS=90
SCREENER_FAILURE_COOLDOWN_SECONDS=300
FINNHUB_REQUEST_TIMEOUT_SECONDS=4
FINNHUB_CACHE_TTL_SECONDS=120
FINNHUB_FAILURE_COOLDOWN_SECONDS=180
FINNHUB_MAX_SYMBOLS_PER_REFRESH=16
SEND_STARTUP_BRIEFING=false

# Trade screener risk controls
# TRADE_MIN_SCORE is deprecated and ignored (see README) — left at its old
# default so it does not trigger the startup deprecation warning.
TRADE_MIN_SCORE=3
TRADE_MIN_WEEK_MOMENTUM_PCT=1.0
TRADE_MIN_DAY_CHANGE_PCT=0.0
TRADE_MIN_VOLUME_RATIO=1.2
TRADE_MAX_DRAWDOWN_PCT=8.0
TRADE_MAX_ATR_PCT=4.5
# Screener discovery is round-robined across these ids (see
# _build_live_universe), so pairing a momentum source like day_gainers with a
# calmer one like undervalued_large_caps actually contributes candidates that
# can clear TRADE_MAX_ATR_PCT, instead of the volatile screener filling every
# slot before the calmer one gets a look-in.
STOCK_SCREENERS=day_gainers,most_actives,undervalued_large_caps,growth_technology_stocks
# Candidate analysis performance controls
TRADE_UNIVERSE_MAX=30
TRADE_FETCH_WORKERS=6
TRADE_HISTORY_CACHE_TTL_SECONDS=600
TRADE_TOTAL_DEADLINE_SECONDS=45

# Optional universe overrides
# Format: Label:SYMBOL,Label 2:SYMBOL2
USA_STOCK_UNIVERSE=
INDIA_STOCK_UNIVERSE=
NORWAY_STOCK_UNIVERSE=
# EU_STOCK_UNIVERSE is the one exception: it falls back to a built-in list of
# large-cap eurozone names (SAP, ASML, LVMH, ...) rather than an empty one,
# because Yahoo's live screener endpoint only ever returns US-market data --
# EU symbols have no discovery path other than this configured list. Set it
# to override the default.
EU_STOCK_UNIVERSE=
INDIA_MUTUAL_FUNDS=
NORWAY_MUTUAL_FUNDS=

# Logging.
# LOG_LEVEL controls the bot's own APP and SYS bands.
# LOG_LEVEL_LIBRARIES controls third-party output (APScheduler, yfinance,
# urllib3) separately, so LOG_LEVEL=DEBUG does not make urllib3 emit a line
# per socket.
LOG_LEVEL=INFO
LOG_LEVEL_LIBRARIES=WARNING
# ANSI colour in container logs. Defaults on -- a container has no TTY, so
# TTY detection would disable colour exactly where it is wanted.
LOG_COLOR=true
