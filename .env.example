TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: mirror every outbound message (briefings, /commands, health ping)
# to a Slack incoming webhook alongside Telegram. Leave blank to disable --
# Slack is a one-way broadcast mirror, it cannot receive /commands back.
SLACK_WEBHOOK_URL=
SLACK_MESSAGE_MAX_CHARS=3900
# Chart images for Slack. The webhook above can only post text -- posting a
# file needs the Web API, which is still outbound-only (no exposed port, no
# Socket Mode) but authenticates with a bot token rather than a webhook URL.
# Create a Slack app, give it the files:write scope, install it, invite the
# bot to the channel, then set both of these. Leave either blank and Slack
# keeps receiving the text rendering only, exactly as before.
# SLACK_CHANNEL_ID is the channel's ID (e.g. C0123ABCDEF), not its name.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
NEWS_API_KEY=
FREENEWS_API_KEY=
# Optional backward-compatible alias if you already use this variable name
FREEN_EWS_API_KEY=
# Finnhub key (supports both spellings for compatibility)
FINNHUB_API_KEY=
FINHUB_API_KEY=
NEWS_FETCH_PRIORITY=newsapi,freenews,rss
FREENEWS_API_URL=https://freenewsapi.com/api/v1/news
FINNHUB_API_URL=https://finnhub.io/api/v1

# Personalization
RECIPIENT_NAME=Sunil
TZ=Europe/Oslo

# Bot runtime
REQUEST_TIMEOUT_SECONDS=15
TELEGRAM_MESSAGE_MAX_CHARS=3900
# Under docker compose this is set to /app/data/ by the compose file itself
# (the news_bot_data volume) and this value is ignored. It applies only when
# running news_bot.py directly on a host.
STATE_FILE=.news_bot_state.json
COMMAND_POLL_ENABLED=true
# Telegram long-poll hold time in seconds (commands respond near-instantly).
COMMAND_LONG_POLL_TIMEOUT_SECONDS=25
# Deprecated: retained for compatibility, no longer used (long-polling replaced interval polling).
COMMAND_POLL_INTERVAL_MINUTES=2
HEALTH_PING_ENABLED=true
HEALTH_PING_CHAT_ID=

# News quality filters (comma-separated domains)
# Note: BBC RSS links point at bbc.co.uk, so both BBC domains are listed.
# A trusted domain missing from this list means those items are dropped silently.
TRUSTED_NEWS_DOMAINS=reuters.com,bloomberg.com,cnbc.com,finance.yahoo.com,yahoo.com,ft.com,bbc.com,bbc.co.uk,theguardian.com,nrk.no,aftenposten.no,e24.no,apnews.com,marketwatch.com,npr.org
BLOCKED_NEWS_DOMAINS=news.google.com,pinterest.com,tiktok.com

# News ranking and deduplication
# Ranking runs on a local LLM (Ollama). No API key and no data leaves your
# network. If the endpoint is unreachable the bot falls back to a
# deterministic heuristic ranker and the briefing still renders.
NEWS_RANKER_ENABLED=true
# `ollama` resolves to whichever Ollama is on the ranker network (see
# RANKER_NETWORK below). Use http://localhost:11434 outside Docker.
NEWS_RANKER_URL=http://ollama:11434
# Must already be pulled into Ollama. qwen2.5:3b (~1.9GB) fits a Raspberry Pi
# 5; a 7B+ model ranks noticeably better if you have the RAM and disk.
NEWS_RANKER_MODEL=qwen2.5:3b
# Measured on a Pi 5 with a warm qwen2.5:3b: 14 candidates ~107s, 20 ~236s.
# llama3.2:3b needs ~193s at 14 and exceeds the 240s timeout at 20.
NEWS_RANKER_TIMEOUT_SECONDS=240
# The LLM re-ranks the heuristic's top N instead of the whole pool. Raise it
# on faster hardware; latency scales roughly with this number.
NEWS_RANKER_MAX_CANDIDATES=14
# Seconds allowed to compose one briefing; news sections not yet started when it
# runs out are skipped and the briefing goes out without them.
BRIEFING_BUDGET_SECONDS=900

# Reuse an Ollama from another compose project instead of the bundled one:
#   RANKER_NETWORK=poster-bot_default
#   RANKER_NETWORK_EXTERNAL=true
# Find the network with:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}' ollama
RANKER_NETWORK=
RANKER_NETWORK_EXTERNAL=false
# Drop dated items older than this. Items with no date are exempt.
NEWS_MAX_AGE_HOURS=30
NEWS_CANDIDATE_POOL_SIZE=60
# Suppress a story shown in the last N days (N includes today).
NEWS_DEDUP_WINDOW_DAYS=7
# Recent titles passed to the ranker for cross-day paraphrase suppression.
NEWS_RECENT_TITLE_DAYS=3
# Weight overrides only, e.g. markets:2.5,sports:0.1
# Categories: markets, norway, india, tech, sports, celebrity, crime,
# lifestyle, shopping
NEWS_TOPIC_WEIGHTS=

# Public feed configuration (comma-separated URLs / screener IDs)
GLOBAL_NEWS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.cnbc.com/id/100727362/device/rss/rss.html,https://feeds.npr.org/1001/rss.xml
BUSINESS_NEWS_FEEDS=https://www.cnbc.com/id/10001147/device/rss/rss.html,https://feeds.bbci.co.uk/news/business/rss.xml,https://feeds.marketwatch.com/marketwatch/topstories/
NORWAY_NEWS_FEEDS=https://www.nrk.no/toppsaker.rss,https://e24.no/rss,https://www.aftenposten.no/rss
FUND_SCREENERS=conservative_foreign_funds,solid_large_growth_funds,high_yield_bond
SCREENER_QUOTE_LIMIT=50
SCREENER_REQUEST_TIMEOUT_SECONDS=6
SCREENER_CACHE_TTL_SECONDS=90
SCREENER_FAILURE_COOLDOWN_SECONDS=300
FINNHUB_REQUEST_TIMEOUT_SECONDS=4
FINNHUB_CACHE_TTL_SECONDS=120
FINNHUB_FAILURE_COOLDOWN_SECONDS=180
FINNHUB_MAX_SYMBOLS_PER_REFRESH=16
SEND_STARTUP_BRIEFING=false

# Trade screener risk controls
TRADE_MIN_WEEK_MOMENTUM_PCT=1.0
TRADE_MIN_DAY_CHANGE_PCT=0.0
TRADE_MIN_VOLUME_RATIO=1.2
TRADE_MAX_DRAWDOWN_PCT=8.0
TRADE_MAX_ATR_PCT=4.5
# Screener discovery is round-robined across these ids (see
# _build_live_universe), so pairing a momentum source like day_gainers with a
# calmer one like undervalued_large_caps actually contributes candidates that
# can clear TRADE_MAX_ATR_PCT, instead of the volatile screener filling every
# slot before the calmer one gets a look-in.
STOCK_SCREENERS=day_gainers,most_actives,undervalued_large_caps,growth_technology_stocks
# Candidate analysis performance controls
TRADE_UNIVERSE_MAX=30
# Stocks whose analyst estimates and key numbers are saved nightly at 02:30
# (the configured universes first, then recently screened stocks).
SNAPSHOT_MAX_SYMBOLS=120
TRADE_FETCH_WORKERS=6
TRADE_HISTORY_CACHE_TTL_SECONDS=600
TRADE_TOTAL_DEADLINE_SECONDS=45
# Rolling history of the screener's own daily measurements (SQLite, stdlib
# sqlite3 -- no extra dependency), used for streaks and weekly picks.
# Same as STATE_FILE: compose pins this into the news_bot_data volume and
# ignores this value. Applies only to a direct, non-container run.
TRADE_HISTORY_DB_FILE=.news_bot_trade_history.db
TRADE_HISTORY_RETENTION_DAYS=14

# Nightly snapshot of the trade-history DB (signal_archive and
# published_picks -- the only out-of-sample record, and the one thing here git
# cannot rebuild). The compose file mounts the host path below at
# /app/backups and pins TRADE_BACKUP_DIR to it, so set the host side here.
# Point it at storage other than the SD card; off-box is better still.
TRADE_BACKUP_HOST_DIR=./backups
TRADE_BACKUP_KEEP=14
# Trading-session hold used by /performance, /forwardtest and /pickperformance.
# The legacy variable name is kept for compatibility; the value is counted in
# completed market sessions. 20 matches the owner's 2-4 week hold (#122); each
# row keeps the hold it was recorded with, and reports only count the current one.
TRADE_OUTCOME_LOOKBACK_DAYS=20
# Evaluation only: configured preserves current stock lists; broad-v1 selects
# the fixed 44-stock, four-market basket in evaluation_universe.csv.
# Neither option changes live recommendations or discovery.
TRADE_BACKTEST_UNIVERSE=configured
TRADE_BACKTEST_UNIVERSE_MAX=100
# Historical daily bars used by /performance and /diagnostics.
TRADE_BACKTEST_PERIOD=2y
# Estimated transaction cost in basis points per side (round-trip cost is
# twice this value). Adjust for your market, broker, and instrument.
TRADE_BACKTEST_COST_BPS=10
# Blank: reserve the final 25% of signal dates. Freeze the displayed date here
# before tuning on development data; never tune on the holdout results.
TRADE_BACKTEST_HOLDOUT_START=
# Evaluation only: minimum prior 20-session average volume, in shares/day.
# Missing volume fails the screen. Set 0 to disable; not a spread guarantee.
TRADE_BACKTEST_MIN_AVG_VOLUME=100000
# Benchmark map uses exchange suffixes; DEFAULT covers symbols without a
# suffix. Override proxies for your universe/market as needed.
TRADE_BACKTEST_BENCHMARKS=DEFAULT:SPY,.NS:^NSEI,.BO:^BSESN,.OL:OSEBX.OL,.DE:^GDAXI,.PA:^FCHI,.AS:^AEX,.MI:FTSEMIB.MI,.MC:^IBEX,.BR:^BFX,.L:^FTSE,.SW:^SSMI,.ST:^OMX,.CO:^OMXC25,.HE:^OMXH25
# /stocks: weekly top picks, ranked by qualifying-day consistency over the
# lookback window (not a fresh live re-scan -- see /recommendations for that).
TRADE_WEEKLY_TOP_PICKS_LOOKBACK_DAYS=7
TRADE_WEEKLY_TOP_PICKS_MIN_QUALIFYING_DAYS=2
TRADE_WEEKLY_TOP_PICKS_COUNT=5
# Universe continuity. /stocks reads recorded history, so it needs symbols
# re-screened across multiple sessions. Recently seen symbols are carried into
# the universe before discovery, while this many slots stay reserved for new
# names so a long-lived tracked set cannot freeze the screen.
TRADE_STICKY_UNIVERSE_DAYS=10
TRADE_DISCOVERY_MIN_SLOTS=10
# Technical-analysis charts attached to /recommendations (price vs EMA20, the
# 20-day range, volume, RSI). Sent to Telegram, and uploaded to Slack too when
# SLACK_BOT_TOKEN and SLACK_CHANNEL_ID are set (a webhook alone cannot upload). Set
# TRADE_CHART_ENABLED=false to go back to text everywhere.
TRADE_CHART_ENABLED=true
TRADE_CHART_COUNT=3
TRADE_CHART_LOOKBACK_DAYS=90
# /analyze TICKER: fundamentals cache (6h -- these move far slower than price)
# and business-summary truncation length.
TICKER_INFO_CACHE_TTL_SECONDS=21600
TICKER_ANALYSIS_SUMMARY_MAX_CHARS=500

# Optional universe overrides
# Format: Label:SYMBOL,Label 2:SYMBOL2
# These are also what /watchlist reports on: leave them empty and /watchlist
# has nothing to show, and the trade screen runs on discovered movers alone.
USA_STOCK_UNIVERSE=
INDIA_STOCK_UNIVERSE=
NORWAY_STOCK_UNIVERSE=
# EU_STOCK_UNIVERSE is the one exception: it falls back to a built-in list of
# large-cap eurozone names (SAP, ASML, LVMH, ...) rather than an empty one,
# because Yahoo's live screener endpoint only ever returns US-market data --
# EU symbols have no discovery path other than this configured list. Set it
# to override the default.
EU_STOCK_UNIVERSE=
INDIA_MUTUAL_FUNDS=
NORWAY_MUTUAL_FUNDS=

# Logging.
# LOG_LEVEL controls the bot's own APP and SYS bands.
# LOG_LEVEL_LIBRARIES controls third-party output (APScheduler, yfinance,
# urllib3) separately, so LOG_LEVEL=DEBUG does not make urllib3 emit a line
# per socket.
LOG_LEVEL=INFO
LOG_LEVEL_LIBRARIES=WARNING
# ANSI colour in container logs. Defaults on -- a container has no TTY, so
# TTY detection would disable colour exactly where it is wanted.
LOG_COLOR=true

# Market-data alerting: Telegram message when too many symbols return no data in
# a screen, or the newest price session is stale. Two consecutive bad screens
# alert (a total outage alerts at once); one all-clear on recovery.
MARKET_DATA_ALERTS_ENABLED=true
MARKET_DATA_ALERT_RATIO=0.5
MARKET_DATA_MAX_STALE_DAYS=6

# Risk analytics shown under each trade candidate and in /analyze: a volatility
# stop (RISK_STOP_ATR_MULTIPLE x ATR), a position size that risks
# RISK_PER_TRADE_PCT of the portfolio on that stop (capped at
# RISK_MAX_POSITION_PCT), clustering warnings when picks move together or share a
# sector, and earnings-date flags inside the holding period. Set RISK_ACCOUNT_SIZE
# (your account currency) to also see an amount.
# The values below are the owner's (2026-11-11), not the code defaults: a 2-4
# week hold with a 3xATR stop (docs/research section 8), and 2% risk per trade so
# a typical stock gets ~12,000 NOK of a 50,000 NOK account -- smaller positions
# pay more than the average gain in DNB's 59 NOK minimum fee. Four stops hit at
# once lose about 8% of the account, more if prices gap.
RISK_ANALYTICS_ENABLED=true
RISK_PER_TRADE_PCT=2.0
RISK_STOP_ATR_MULTIPLE=3.0
RISK_MAX_POSITION_PCT=25
RISK_MAX_TOTAL_PCT=100
RISK_ACCOUNT_SIZE=0
RISK_CORR_THRESHOLD=0.7
# Calendar days; 28 covers a 20-session hold.
RISK_EARNINGS_WARN_DAYS=28
# /analyze and /check: how much a stock can fall over a 2-4 week hold.
RISK_FORECAST_ENABLED=true
# Broker fee per order, shown next to each pick (DNB: 0.12%, at least 59 NOK).
# Set RISK_ACCOUNT_SIZE above to see the fee as a percent of the position.
BROKER_FEE_MIN_NOK=59
BROKER_FEE_PCT=0.12
# Weekday 22:30 Telegram alert for stocks logged with /fill: a fall this many
# percent below the average buy price, earnings within RISK_EARNINGS_WARN_DAYS,
# or a headline about the company. Each alert is sent once.
HOLDING_ALERT_DROP_PCT=15
# The index fund the real trades are compared with on the 1st of each month
# (/scorecard any time). Yahoo ticker and display name.
BENCHMARK_FUND_SYMBOL=0P00018V9L.IR
BENCHMARK_FUND_NAME=KLP AksjeGlobal Indeks P

# Relative strength under each candidate: the stock's return over these completed
# sessions minus its market's (and, for US listings, its sector ETF's), plus beta.
RELATIVE_STRENGTH_ENABLED=true
RELATIVE_STRENGTH_WINDOWS=20,60

# Headlines that mention a pick (by company name, or $TICKER / (TICKER)), taken from
# the business and global feeds the bot already reads. Shown under the candidate.
CATALYSTS_ENABLED=true
CATALYSTS_MAX_PER_PICK=2
CATALYSTS_MAX_AGE_HOURS=36
